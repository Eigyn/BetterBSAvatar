<bg anchor-min='0.5 0.5' anchor-max='0.5 0.5' size-delta='71 76'>
  <text text='Display Settings' font-size='3.5' align='Center' font-color='#FFFFFF88'
        anchor-min='0.5 0.5' anchor-max='0.5 0.5' anchored-position='0 -9' size-delta='71 6' />
  <checkbox-setting text='Enable Avatar' value='enable-avatar' bind-value='true' apply-on-change='true'
                    pivot='0.5 0.5'
                    anchor-min='0.5 0.5' anchor-max='0.5 0.5' anchored-position='0 -20' size-delta='71 8'
                    hover-hint='Displays your built-in avatar in menus and single-player gameplay.' />
  <checkbox-setting text='Show in First Person' value='show-first-person' bind-value='true' apply-on-change='true'
                    pivot='0.5 0.5'
                    anchor-min='0.5 0.5' anchor-max='0.5 0.5' anchored-position='0 -31' size-delta='71 8'
                    hover-hint='Shows the avatar in the headset view. Third-person cameras can still see it when this is off.' />
</bg>
